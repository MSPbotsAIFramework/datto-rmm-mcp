# Optional overrides - datto-rmm-mcp has no required env vars.
# Authentication is per-request via three headers (provided by the MCP caller):
#   X-Datto-Api-Key     Tenant's Datto RMM API key. Used as the OAuth2
#                       password-grant username.
#   X-Datto-Api-Secret  Tenant's Datto RMM API secret key. Used as the
#                       grant's password.
#   X-Datto-Api-Url     The tenant's region-specific Datto RMM API host,
#                       e.g. zinfandel-api.centrastage.net (bare host or a
#                       full https:// URL both work - normalized internally).
#                       Datto RMM is multi-region; there is no single default.
#
# This server exchanges these for a bearer token itself (Datto's OAuth2
# client_id/secret for this grant are fixed public constants, not a secret
# worth guarding at a gateway) and never persists the token beyond one
# request.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
